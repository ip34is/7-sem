%% Дерево атак для найкритичнішої загрози T-01 (CVSS 8.6).
%% Прямокутники — мета/підцілі, ромби — логічні вузли, сірі овали — листові дії.
flowchart LR
    root["МЕТА (T-01): отримати повні тексти документів<br/>обмеженого доступу з пошукового індексу D3"]
    or0{OR}
    root --> or0

    b1["1. Прямий доступ до REST API OpenSearch"]
    and1{AND}
    or0 --> b1 --> and1
    f11["1.1 Знайти доступний ендпойнт"]
    or11{OR}
    and1 --> f11 --> or11
    l111([1.1.1 Просканувати публічну IP-адресу<br/>кафедри на порт 9200/TCP]):::leaf
    l112([1.1.2 Знайти шлях /search-api/ у JS-бандлі,<br/>який P1 проксіює до D3]):::leaf
    or11 --> l111
    or11 --> l112
    l12([1.2 Надіслати GET /_cat/indices без облікових даних:<br/>security plugin вимкнено]):::leaf
    l13([1.3 Вивантажити індекс docs запитами<br/>_search?scroll=5m&size=10000]):::leaf
    and1 --> l12
    and1 --> l13

    b2["2. Зібрати фрагменти через пошук застосунку P2 (T-03)"]
    and2{AND}
    or0 --> b2 --> and2
    l21([2.1 Увійти через SSO з обліковим<br/>записом будь-якого здобувача]):::leaf
    l22([2.2 Надсилати запити «наказ відрахування»,<br/>ПІБ, номери наказів з highlight=true]):::leaf
    l23([2.3 Склеїти фрагменти з відповідей,<br/>до яких ACL не застосовано]):::leaf
    and2 --> l21
    and2 --> l22
    and2 --> l23

    b3["3. Отримати знімок індексу (T-11)"]
    or3{OR}
    or0 --> b3 --> or3
    l31([3.1 Завантажити незашифрований snapshot із D5<br/>ключем, викраденим із cron-скрипта P4]):::leaf
    l32([3.2 Через відкритий API зареєструвати власний<br/>_snapshot-репозиторій і зберегти індекс до себе]):::leaf
    or3 --> l31
    or3 --> l32

    b4["4. Підключитися до D3 з викраденими обліковими даними"]
    and4{AND}
    or0 --> b4 --> and4
    f41["4.1 Отримати облікові дані OpenSearch"]
    or41{OR}
    and4 --> f41 --> or41
    l411([4.1.1 Прочитати змінні оточення на сторінці<br/>помилки в режимі налагодження, T-08]):::leaf
    l412([4.1.2 Виконати код в обробнику P3 через<br/>шкідливий DOCX, T-21, і прочитати .env]):::leaf
    or41 --> l411
    or41 --> l412
    l42([4.2 Надіслати запити до D3 із<br/>скомпрометованого вузла внутрішньої мережі]):::leaf
    and4 --> l42

    classDef leaf fill:#eee,stroke:#333;
