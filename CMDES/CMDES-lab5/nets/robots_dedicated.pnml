      <transition id="return3">
        <name>
          <text>повернення 3</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>5.0</timeDelay>
          <delayMeanValue>5.0</delayMeanValue>
        </toolspecific>
        <graphics>
          <position x="1950" y="-320"/>
        </graphics>
      </transition>
