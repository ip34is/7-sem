<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="RobotsDedicated" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name>
      <text>RobotsDedicated</text>
    </name>
    <page id="object0">
      <name>
        <text>Free elements</text>
      </name>
      <toolspecific tool="PetriObjModel" version="2.8.1">
        <petriObject contentVisible="true" index="0" modelId="free" name="Free elements" priority="0" x="0" y="0"/>
      </toolspecific>
      <place id="gen">
        <name>
          <text>генератор</text>
        </name>
        <initialMarking>
          <text>1</text>
        </initialMarking>
        <graphics>
          <position x="-450" y="0"/>
        </graphics>
      </place>
      <place id="readyA">
        <name>
          <text>деталь на пункті прибуття</text>
        </name>
        <graphics>
          <position x="-150" y="0"/>
        </graphics>
      </place>
      <place id="onM1">
        <name>
          <text>деталь на верстат 1</text>
        </name>
        <graphics>
          <position x="450" y="0"/>
        </graphics>
      </place>
      <place id="readyM1">
        <name>
          <text>оброблено на верстат 1</text>
        </name>
        <graphics>
          <position x="750" y="0"/>
        </graphics>
      </place>
      <place id="slotsM1">
        <name>
          <text>вільні місця верстат 1</text>
        </name>
        <initialMarking>
          <text>3</text>
        </initialMarking>
        <graphics>
          <position x="300" y="260"/>
        </graphics>
      </place>
      <place id="onM2">
        <name>
          <text>деталь на верстат 2</text>
        </name>
        <graphics>
          <position x="1350" y="0"/>
        </graphics>
      </place>
      <place id="readyM2">
        <name>
          <text>оброблено на верстат 2</text>
        </name>
        <graphics>
          <position x="1650" y="0"/>
        </graphics>
      </place>
      <place id="slotsM2">
        <name>
          <text>вільні місця верстат 2</text>
        </name>
        <initialMarking>
          <text>3</text>
        </initialMarking>
        <graphics>
          <position x="1200" y="260"/>
        </graphics>
      </place>
      <place id="stored">
        <name>
          <text>склад</text>
        </name>
        <graphics>
          <position x="2250" y="0"/>
        </graphics>
      </place>
      <place id="home1">
        <name>
          <text>робот 1 вільний</text>
        </name>
        <initialMarking>
          <text>1</text>
        </initialMarking>
        <graphics>
          <position x="0" y="-180"/>
        </graphics>
      </place>
      <place id="loaded1">
        <name>
          <text>робот 1 з деталлю</text>
        </name>
        <graphics>
          <position x="150" y="0"/>
        </graphics>
      </place>
      <place id="back1">
        <name>
          <text>робот 1 повертається</text>
        </name>
        <graphics>
          <position x="300" y="-180"/>
        </graphics>
      </place>
      <place id="home2">
        <name>
          <text>робот 2 вільний</text>
        </name>
        <initialMarking>
          <text>1</text>
        </initialMarking>
        <graphics>
          <position x="900" y="-180"/>
        </graphics>
      </place>
      <place id="loaded2">
        <name>
          <text>робот 2 з деталлю</text>
        </name>
        <graphics>
          <position x="1050" y="0"/>
        </graphics>
      </place>
      <place id="back2">
        <name>
          <text>робот 2 повертається</text>
        </name>
        <graphics>
          <position x="1200" y="-180"/>
        </graphics>
      </place>
      <place id="home3">
        <name>
          <text>робот 3 вільний</text>
        </name>
        <initialMarking>
          <text>1</text>
        </initialMarking>
        <graphics>
          <position x="1800" y="-180"/>
        </graphics>
      </place>
      <place id="loaded3">
        <name>
          <text>робот 3 з деталлю</text>
        </name>
        <graphics>
          <position x="1950" y="0"/>
        </graphics>
      </place>
      <place id="back3">
        <name>
          <text>робот 3 повертається</text>
        </name>
        <graphics>
          <position x="2100" y="-180"/>
        </graphics>
      </place>
      <transition id="arrive">
        <name>
          <text>надходження</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>40.0</timeDelay>
          <delayMeanValue>40.0</delayMeanValue>
          <distribution>exp</distribution>
        </toolspecific>
        <graphics>
          <position x="-300" y="0"/>
        </graphics>
      </transition>
      <transition id="procM1">
        <name>
          <text>обробка верстат 1</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>60.0</timeDelay>
          <delayMeanValue>60.0</delayMeanValue>
          <standardDeviation>10.0</standardDeviation>
          <distribution>norm</distribution>
        </toolspecific>
        <graphics>
          <position x="600" y="0"/>
        </graphics>
      </transition>
      <transition id="procM2">
        <name>
          <text>обробка верстат 2</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>100.0</timeDelay>
          <delayMeanValue>100.0</delayMeanValue>
          <distribution>exp</distribution>
        </toolspecific>
        <graphics>
          <position x="1500" y="0"/>
        </graphics>
      </transition>
      <transition id="grab1">
        <name>
          <text>захоплення 1</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>8.0</timeDelay>
          <delayMeanValue>8.0</delayMeanValue>
          <standardDeviation>1.0</standardDeviation>
          <distribution>unif</distribution>
        </toolspecific>
        <graphics>
          <position x="0" y="0"/>
        </graphics>
      </transition>
      <transition id="carry1">
        <name>
          <text>переміщення і вивільнення 1</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>14.0</timeDelay>
          <delayMeanValue>14.0</delayMeanValue>
          <standardDeviation>1.0</standardDeviation>
          <distribution>unif</distribution>
        </toolspecific>
        <graphics>
          <position x="300" y="0"/>
        </graphics>
      </transition>
      <transition id="return1">
        <name>
          <text>повернення 1</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>6.0</timeDelay>
          <delayMeanValue>6.0</delayMeanValue>
        </toolspecific>
        <graphics>
          <position x="150" y="-320"/>
        </graphics>
      </transition>
      <transition id="grab2">
        <name>
          <text>захоплення 2</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>8.0</timeDelay>
          <delayMeanValue>8.0</delayMeanValue>
          <standardDeviation>1.0</standardDeviation>
          <distribution>unif</distribution>
        </toolspecific>
        <graphics>
          <position x="900" y="0"/>
        </graphics>
      </transition>
      <transition id="carry2">
        <name>
          <text>переміщення і вивільнення 2</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>15.0</timeDelay>
          <delayMeanValue>15.0</delayMeanValue>
          <standardDeviation>1.0</standardDeviation>
          <distribution>unif</distribution>
        </toolspecific>
        <graphics>
          <position x="1200" y="0"/>
        </graphics>
      </transition>
      <transition id="return2">
        <name>
          <text>повернення 2</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>7.0</timeDelay>
          <delayMeanValue>7.0</delayMeanValue>
        </toolspecific>
        <graphics>
          <position x="1050" y="-320"/>
        </graphics>
      </transition>
      <transition id="grab3">
        <name>
          <text>захоплення 3</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>8.0</timeDelay>
          <delayMeanValue>8.0</delayMeanValue>
          <standardDeviation>1.0</standardDeviation>
          <distribution>unif</distribution>
        </toolspecific>
        <graphics>
          <position x="1800" y="0"/>
        </graphics>
      </transition>
      <transition id="carry3">
        <name>
          <text>переміщення і вивільнення 3</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.8.1">
          <timeDelay>13.0</timeDelay>
          <delayMeanValue>13.0</delayMeanValue>
          <standardDeviation>1.0</standardDeviation>
          <distribution>unif</distribution>
        </toolspecific>
        <graphics>
          <position x="2100" y="0"/>
